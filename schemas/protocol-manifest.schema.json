{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prumo.dev/schemas/protocol-manifest.schema.json",
  "title": "Prumo protocol manifest",
  "description": "Generated by the Prumo compiler from content/PRUMO.md. Never edited by hand.",
  "type": "object",
  "required": ["generatedBy", "protocolVersion", "sourceHash", "ruleCount", "ruleRange", "sections", "chapters", "kernel", "reminder", "precedence", "critical", "coverage", "targets", "rules"],
  "additionalProperties": false,
  "properties": {
    "generatedBy": { "type": "string" },
    "protocolVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ruleCount": { "type": "integer", "minimum": 1 },
    "ruleRange": {
      "type": "object",
      "required": ["first", "last"],
      "properties": { "first": { "$ref": "#/$defs/ruleId" }, "last": { "$ref": "#/$defs/ruleId" } }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "line", "rules"],
        "properties": {
          "number": { "type": ["integer", "string"] },
          "appendix": { "type": ["boolean", "string"] },
          "title": { "type": "string" },
          "line": { "type": "integer" },
          "rules": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "sections", "defaultLoad", "nonSuppressible", "rules", "tokens", "triggers"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$" },
          "title": { "type": "string" },
          "sections": { "type": "array", "items": { "type": "integer" } },
          "defaultLoad": { "type": "boolean" },
          "nonSuppressible": { "type": "boolean" },
          "rules": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } },
          "tokens": { "type": "integer" },
          "triggers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "description"],
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "signals": { "type": "array", "items": { "type": "string" } },
                "keywords": { "type": "array", "items": { "type": "string" } },
                "paths": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "kernel": {
      "type": "object",
      "required": ["rules", "tokens", "budget"],
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } },
        "tokens": { "type": "integer", "maximum": 2500 },
        "budget": { "type": "integer", "const": 2500 },
        "hash": { "type": "string" }
      }
    },
    "reminder": {
      "type": "object",
      "required": ["rules", "tokens", "text"],
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } },
        "tokens": { "type": "integer" },
        "text": { "type": "string" }
      }
    },
    "precedence": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "critical": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } },
    "coverage": { "type": "object", "additionalProperties": { "type": "integer" } },
    "targets": { "type": "array", "items": { "type": "string" } },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "section", "title", "tier", "reminder", "critical", "chapter", "triggers", "references", "enforcement", "source"],
        "properties": {
          "id": { "$ref": "#/$defs/ruleId" },
          "section": { "type": ["integer", "string"] },
          "title": { "type": "string" },
          "tier": { "enum": ["kernel", "chapter"] },
          "reminder": { "type": "boolean" },
          "critical": { "type": "boolean" },
          "chapter": { "type": "string" },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "references": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } },
          "enforcement": { "enum": ["ENFORCED", "DETERMINISTICALLY_TESTED", "BEHAVIOR_EVAL", "DOCUMENTARY", "MANUAL"] },
          "evalSuite": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["file", "line"],
            "properties": { "file": { "type": "string" }, "line": { "type": "integer" } }
          }
        }
      }
    }
  },
  "$defs": {
    "ruleId": { "type": "string", "pattern": "^PRU-\\d{2,3}$" }
  }
}
