{
  "name": "prumo",
  "version": "2.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "prumo",
      "version": "2.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "bin": {
        "prumo": "bin/prumo.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@prumocode/compiler": {
      "resolved": "packages/compiler",
      "link": true
    },
    "node_modules/@prumocode/installer": {
      "resolved": "packages/installer",
      "link": true
    },
    "node_modules/@prumocode/runtime": {
      "resolved": "packages/runtime",
      "link": true
    },
    "node_modules/@prumocode/verifier": {
      "resolved": "packages/verifier",
      "link": true
    },
    "packages/compiler": {
      "name": "@prumocode/compiler",
      "version": "2.0.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/installer": {
      "name": "@prumocode/installer",
      "version": "2.0.0",
      "license": "MIT",
      "dependencies": {
        "@prumocode/compiler": "2.0.0",
        "@prumocode/runtime": "2.0.0",
        "@prumocode/verifier": "2.0.0"
      },
      "bin": {
        "prumo-install": "bin/prumo-install.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/runtime": {
      "name": "@prumocode/runtime",
      "version": "2.0.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/verifier": {
      "name": "@prumocode/verifier",
      "version": "2.0.0",
      "license": "MIT",
      "dependencies": {
        "@prumocode/compiler": "2.0.0",
        "@prumocode/runtime": "2.0.0"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
