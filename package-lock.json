{
  "name": "prumo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "prumo",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "@slate-terminal/core": "file:../Slate/packages/slate",
        "@slate-terminal/react": "file:../Slate/packages/slate-react"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "../Slate/packages/slate": {
      "name": "@slate-terminal/core",
      "version": "2.3.0",
      "dev": true,
      "license": "Apache-2.0",
      "engines": {
        "node": ">=18"
      },
      "optionalDependencies": {
        "@slate-terminal/native": "2.3.0"
      }
    },
    "../Slate/packages/slate-react": {
      "name": "@slate-terminal/react",
      "version": "2.3.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@slate-terminal/core": "2.3.0"
      },
      "devDependencies": {
        "react": "^19.0.0",
        "react-reconciler": "^0.31.0"
      },
      "engines": {
        "node": ">=18"
      },
      "peerDependencies": {
        "react": "^18.3.0 || ^19.0.0",
        "react-reconciler": "^0.29.2 || ^0.31.0",
        "yoga-layout": ">=3"
      },
      "peerDependenciesMeta": {
        "react": {
          "optional": true
        },
        "react-reconciler": {
          "optional": true
        },
        "yoga-layout": {
          "optional": true
        }
      }
    },
    "node_modules/@prumo/install": {
      "resolved": "packages/installer",
      "link": true
    },
    "node_modules/@slate-terminal/core": {
      "resolved": "../Slate/packages/slate",
      "link": true
    },
    "node_modules/@slate-terminal/react": {
      "resolved": "../Slate/packages/slate-react",
      "link": true
    },
    "packages/installer": {
      "name": "@prumo/install",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "@slate-terminal/react": "2.3.0"
      },
      "bin": {
        "prumo-install": "bin/prumo-install.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
